# Server-only Supabase credentials. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# CRM sign-in credentials. Use a unique password and a random 32+ character session secret.
CRM_USERNAME=replace-with-crm-username
CRM_PASSWORD=replace-with-a-strong-unique-password
CRM_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
